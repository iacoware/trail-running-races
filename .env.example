# JSON della chiave del service account (se inizia con `{`), oppure percorso al file.
# Tenere il file alla radice del repo: ogni *.json lì è ignorato da git.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# id del foglio, dall'URL
SHEET_ID=
# nome del tab, default il primo
SHEET_TAB=
# comando dell'agente, spezzato sugli spazi (niente virgolette)
# alternativa Codex headless verificata (modello + effort):
# AGENT_CMD=codex exec --ephemeral --sandbox read-only --model gpt-5-codex -c model_reasoning_effort=medium -
AGENT_CMD=claude -p --output-format text --allowedTools WebSearch,WebFetch --model opus --effort medium
# timeout per chiamata in secondi
AGENT_TIMEOUT=300
# percorso dell'elenco gare
RACES_FILE=races.txt
