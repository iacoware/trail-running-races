# JSON della chiave del service account (se inizia con `{`), oppure percorso al file.
# Tenere il file alla radice del repo: ogni *.json lì è ignorato da git.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# id del foglio, dall'URL
SHEET_ID=
# nome del tab, default il primo
SHEET_TAB=
# comando shell dell'agente, es. `codex exec`
AGENT_CMD=claude -p --output-format text --allowedTools WebSearch,WebFetch
# timeout per chiamata in secondi
AGENT_TIMEOUT=300
# percorso dell'elenco gare
RACES_FILE=races.txt
