{
    "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
    "extends": [
        "./node_modules/@effect/tsgo/oxlint-presets/antipattern.json",
        "./node_modules/@effect/tsgo/oxlint-presets/correctness.json",
        "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json",
        "./node_modules/@effect/tsgo/oxlint-presets/style.json",
        "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
        "./node_modules/@iacoware/better-effect/presets/all.json"
    ],
    "ignorePatterns": ["node_modules", "fixtures", "tools/oxlint/anti-slop-effect"],
    "jsPlugins": ["./tools/oxlint/anti-slop-effect/index.ts"],
    "rules": {
        "better-effect/adapter-import-boundary": "error",
        "better-effect/no-bare-error-in-effect": "error",
        "better-effect/no-parameterless-catch-all": "error",
        "better-effect/no-provide-on-definition": "error",
        "better-effect/no-transport-types-in-generator": "error",
        "better-effect/provide-named-layer": "error",
        "better-effect/run-only-at-entry": "error",
        "better-effect/service-port-shape-only": "error",
        "better-effect/single-style-per-function": "error",
        "better-effect/try-object-form": "error",
        "anti-slop-effect/no-manual-effect-error-tag": "error",
        "anti-slop-effect/prefer-effect-match": "error",
        "anti-slop-effect/no-manual-tag-comparison": "error",
        "anti-slop-effect/no-manual-tagged-construction": "error",
        "effecttsgo/missing-pipeable-signature": "off"
    },
    "overrides": [
        {
            "files": ["src/main.ts"],
            "rules": {
                "effecttsgo/strict-effect-provide": "off"
            }
        },
        {
            "files": ["test/dryRun.test.ts", "src/testing/fakeAgent.ts"],
            "rules": {
                "effecttsgo/async-function": "off",
                "effecttsgo/new-promise": "off",
                "effecttsgo/node-builtin-import": "off",
                "effecttsgo/global-console": "off",
                "effecttsgo/global-timers": "off"
            }
        },
        {
            "files": ["**/*.test.ts", "src/testing/**"],
            "rules": {
                "anti-slop-effect/no-manual-tagged-construction": "off",
                "effecttsgo/strict-effect-provide": "off"
            }
        }
    ]
}
