{
    "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
    "extends": [
        "./node_modules/@effect/tsgo/oxlint-presets/antipattern.json",
        "./node_modules/@effect/tsgo/oxlint-presets/correctness.json",
        "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json",
        "./node_modules/@effect/tsgo/oxlint-presets/style.json",
        "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
        "./node_modules/@doubleloop-io/oxlint-plugin-effect/dist/presets/all.json"
    ],
    "ignorePatterns": ["node_modules", "fixtures"],
    "rules": {
        "dl-effect/adapter-import-boundary": "error",
        "dl-effect/no-throw-or-primitive-failure": "error",
        "dl-effect/no-parameterless-catch-all": "error",
        "dl-effect/no-provide-on-definition": "error",
        "dl-effect/no-transport-types-in-generator": "error",
        "dl-effect/provide-named-layer": "error",
        "dl-effect/run-only-in-runner": "error",
        "dl-effect/service-port-shape-only": "error",
        "dl-effect/single-style-per-function": "error",
        "dl-effect/try-object-form": "error",
        "dl-effect/anti-slop-no-manual-effect-error-tag": "error",
        "dl-effect/anti-slop-prefer-effect-match": "error",
        "dl-effect/no-manual-discriminant-comparison": "error",
        "dl-effect/no-manual-discriminant-construction": "error",
        "effecttsgo/missing-pipeable-signature": "off"
    },
    "overrides": [
        {
            "files": ["src/main.ts"],
            "rules": {
                "effecttsgo/strict-effect-provide": "off"
            }
        },
        {
            "files": ["test/dryRun.test.ts", "src/testing/fakeAgent.ts"],
            "rules": {
                "effecttsgo/async-function": "off",
                "effecttsgo/new-promise": "off",
                "effecttsgo/node-builtin-import": "off",
                "effecttsgo/global-console": "off",
                "effecttsgo/global-timers": "off"
            }
        },
        {
            "files": ["**/*.test.ts", "src/testing/**"],
            "rules": {
                "dl-effect/no-manual-discriminant-construction": "off",
                "effecttsgo/strict-effect-provide": "off"
            }
        }
    ]
}
