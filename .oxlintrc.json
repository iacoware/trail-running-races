{
    "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
    "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
    "ignorePatterns": ["node_modules", "fixtures"],
    "jsPlugins": [
        "./tools/oxlint/anti-slop-effect/index.ts",
        "./tools/oxlint/effect-local/index.ts"
    ],
    "rules": {
        "effect-local/boundary-entrypoint-shape": "warn",
        "effect-local/error-handling-in-effect-fn-handler": "warn",
        "effect-local/no-bare-error-in-effect": "error",
        "effect-local/no-effect-promise": "warn",
        "effect-local/no-nested-match": "warn",
        "effect-local/no-parameterless-catch-all": "error",
        "effect-local/no-provide-on-definition": "error",
        "effect-local/no-transport-types-in-generator": "error",
        "effect-local/prefer-effect-fn": "warn",
        "effect-local/provide-named-layer": "error",
        "effect-local/redacted-secret-names": "warn",
        "effect-local/run-only-at-entry": "error",
        "effect-local/service-port-shape-only": "error",
        "effect-local/single-style-per-function": "error",
        "effect-local/try-object-form": "error",
        "anti-slop-effect/no-manual-effect-error-tag": "error",
        "anti-slop-effect/prefer-effect-match": "error",
        "anti-slop-effect/no-manual-tag-comparison": "error",
        "anti-slop-effect/no-manual-tagged-construction": "error",
        "effecttsgo/extends-native-error": "error",
        "effecttsgo/global-error-in-effect-catch": "error",
        "effecttsgo/global-error-in-effect-failure": "error",
        "effecttsgo/unnecessary-fail-yieldable-error": "error",
        "effecttsgo/catch-all-to-map-error": "error",
        "effecttsgo/catch-unfailable-effect": "error",
        "effecttsgo/schema-sync": "error",
        "effecttsgo/schema-sync-in-effect": "error",
        "effecttsgo/process-env": "error",
        "effecttsgo/process-env-in-effect": "error",
        "effecttsgo/effect-fn-opportunity": "error",
        "effecttsgo/leaking-requirements": "error",
        "effecttsgo/run-effect-inside-effect": "error",
        "effecttsgo/strict-effect-provide": "error"
    },
    "overrides": [
        {
            "files": ["src/main.ts"],
            "rules": {
                "effect-local/run-only-at-entry": "off",
                "effecttsgo/strict-effect-provide": "off"
            }
        },
        {
            "files": ["test/dryRun.test.ts", "src/testing/fakeAgent.ts"],
            "rules": {
                "effecttsgo/async-function": "off",
                "effecttsgo/new-promise": "off",
                "effecttsgo/node-builtin-import": "off",
                "effecttsgo/global-console": "off",
                "effecttsgo/global-timers": "off"
            }
        },
        {
            "files": ["**/*.test.ts", "src/testing/**"],
            "rules": {
                "anti-slop-effect/no-manual-tagged-construction": "off",
                "effecttsgo/strict-effect-provide": "off",
                "effect-local/provide-named-layer": "off",
                "effect-local/no-provide-on-definition": "off"
            }
        },
        {
            "files": ["tools/**"],
            "rules": {
                "anti-slop-effect/no-manual-tag-comparison": "off",
                "anti-slop-effect/no-manual-tagged-construction": "off"
            }
        }
    ]
}
